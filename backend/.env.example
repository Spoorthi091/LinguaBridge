# =========================================================
# LinguaBridge Backend — Environment Variables
# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to GitHub.
# =========================================================

# Port the Express server will listen on
PORT=5000

# Base URL of the LibreTranslate instance to use.
# Public free instances (no signup required) include:
#   https://libretranslate.de/translate
#   https://translate.astian.org/translate
# You can also self-host LibreTranslate with Docker:
#   docker run -it -p 5001:5000 libretranslate/libretranslate
# then set this to http://localhost:5001/translate
LIBRETRANSLATE_URL=https://libretranslate.de/translate

# Optional API key, only required by some LibreTranslate instances.
# Leave blank if your chosen instance does not require one.
LIBRETRANSLATE_API_KEY=

# Comma-separated list of origins allowed to call this API.
# Use * during local development, restrict it in production.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500
